# Local chat: no cloud key required.
CHAT_PROVIDER=llama
LLAMA_BASE_URL=http://127.0.0.1:8080/v1
# Optional: exact ID returned by /v1/models; otherwise the first model is selected.
# LLAMA_MODEL=bielik-pl
EMBEDDING_MODEL=bge
# The Docker/Render profile uses the smaller minilm encoder.
EMBEDDING_CACHE_DIR=.data/models
LANCEDB_DIR=.data/lancedb

# Direct Groq alternative. Never commit the real key.
# CHAT_PROVIDER=groq
# GROQ_BASE_URL=https://api.groq.com/openai/v1
# GROQ_MODEL=openai/gpt-oss-120b
# GROQ_API_KEY=

# Optional owner-managed balancer (no Groq keys copied into the app).
# GROQ_BASE_URL=http://127.0.0.1:8787/v1
# GROQ_BALANCER=true
# GROQ_TRANSPORT=windows

# Production-only, per-instance demo controls. All valid chat POSTs/retries count; health GETs do not.
# CHAT_MAX_CONCURRENT=2
# CHAT_REQUESTS_PER_HOUR=120
