# Server-only Groq credential for the shop. Never commit the real key.
GROQ_API_KEY=
# Local-only alternative: point to a file containing API_KEY; ignored on Render.
# AURELLE_GROQ_KEY_FILE=/absolute/path/to/parent/.env

EMBEDDING_MODEL=bge
# The Docker/Render profile uses the smaller minilm encoder.
EMBEDDING_CACHE_DIR=.data/models
LANCEDB_DIR=.data/lancedb

# Per-instance demo controls. Valid chat POSTs and retries count; health GETs do not.
# CHAT_MAX_CONCURRENT=2
# CHAT_REQUESTS_PER_HOUR=120
